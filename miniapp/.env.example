# --- Local browser dev (npm run dev) ---
# Where the FastAPI backend runs. The Vite dev server proxies /api -> this origin,
# so the browser never makes a cross-origin (CORS) request and the backend needs
# no changes. Default is http://localhost:3000.
BACKEND_ORIGIN=http://localhost:3000

# --- API base the app fetches from ---
# Dev (proxy): leave as /api  -> becomes /api/chat -> proxied to BACKEND_ORIGIN/chat
# Production (Zalo): set to the public backend origin, e.g. https://your-domain
#   and whitelist that domain in the Zalo Mini App console. Then it calls
#   https://your-domain/chat directly.
VITE_API_BASE=/api

# --- OpenRouteService (bản đồ + lộ trình trong tab Lịch trình) ---
# Lấy key miễn phí tại https://openrouteservice.org/dev/#/signup rồi dán vào đây.
# Bỏ trống cũng chạy được: app sẽ vẽ đường thẳng + ước lượng thời gian thay cho
# tuyến đường thật.
VITE_ORS_API_KEY=
