# ---- Required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Model & cost ----
MODEL=claude-sonnet-5
MAX_TOKENS=1000
MAX_TOOL_TURNS=8
ENABLE_PROMPT_CACHE=true

# ---- Memory ----
KEEP_RECENT_MESSAGES=8
SESSION_TTL_HOURS=48
DB_PATH=./tripsmart.db

# ---- Abuse prevention ----
RATE_PER_MINUTE=10
RATE_PER_DAY=100
MAX_INPUT_CHARS=2000
DEBOUNCE_MS=800

# ---- Server ----
PORT=3000

# ---- Integrations (fill in when wiring real services) ----
AFFILIATE_TAG=zahackathon-tripsmart
# ZALO_OA_TOKEN=
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=

# ---- Live pricing (SerpApi: Google Flights + Google Hotels) ----
# https://serpapi.com  (free tier ~250 searches/month). Empty = mock prices.
SERPAPI_KEY=
