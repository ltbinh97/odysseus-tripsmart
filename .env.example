# =============================================================================
#  MẪU CẤU HÌNH — copy thành `.env` rồi điền 2 KEY ở mục Required.
#
#  Trên server:   cp .env.example .env  &&  nano .env
#  → điền ANTHROPIC_API_KEY và SERPAPI_KEY, lưu lại, rồi restart service.
#
#  `.env` (bản có key thật) ĐÃ nằm trong .gitignore → KHÔNG BAO GIỜ lên GitHub.
#  File .env.example này chỉ chứa placeholder, an toàn để public.
# =============================================================================

# ---- Required (BẮT BUỘC điền) ----
ANTHROPIC_API_KEY=sk-ant-...        # https://console.anthropic.com/settings/keys
SERPAPI_KEY=                        # https://serpapi.com  (free ~250 search/tháng)
#   Trống SERPAPI_KEY → vé/khách sạn/địa điểm trả "tạm thời chưa tra được" (KHÔNG bịa số).

# ---- Model & cost ----
MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=1000
MAX_TOOL_TURNS=8
ENABLE_PROMPT_CACHE=true

# ---- Memory ----
KEEP_RECENT_MESSAGES=8
SESSION_TTL_HOURS=48
DB_PATH=./tripsmart.db

# ---- Shared cache + suggestions (tiết kiệm SerpApi) ----
CACHE_TTL_HOURS=24                  # TTL cache giá vé/khách sạn
PLACES_TTL_HOURS=168                # TTL cache POI (7 ngày)
SUGGESTIONS_LIMIT=6                 # số điểm đến gợi ý mặc định

# ---- Abuse prevention ----
RATE_PER_MINUTE=10
RATE_PER_DAY=100
MAX_INPUT_CHARS=2000
DEBOUNCE_MS=800

# ---- Server ----
PORT=3000                           # systemd chạy uvicorn cố định ở 3100 (nginx proxy về đây)
# CORS_ALLOW_ORIGINS=*              # mặc định "*"; siết lại thành CSV origin nếu muốn

# ---- Integrations (điền khi cắm dịch vụ thật) ----
AFFILIATE_TAG=zahackathon-tripsmart
# ZALO_OA_TOKEN=
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
