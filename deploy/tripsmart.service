[Unit]
Description=TripSmart backend (FastAPI/uvicorn) for the Odysseus Zalo Mini App
After=network.target

[Service]
Type=simple
User=zah19-team40
# Deployed under /opt (NOT /home) so SELinux lets systemd exec the binary — a
# service running from a home dir (user_home_t) is denied by RHEL targeted policy.
WorkingDirectory=/opt/tripsmart
EnvironmentFile=/opt/tripsmart/.env
# .venv created on the server (see deploy/README.md). Binds to localhost only —
# nginx terminates TLS on 443 and reverse-proxies to this port.
ExecStart=/opt/tripsmart/.venv/bin/uvicorn tripsmart.server:app --host 127.0.0.1 --port 3100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
